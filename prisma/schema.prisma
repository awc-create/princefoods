// ---------- Prisma Client ----------
generator client {
  provider = "prisma-client-js"
}

// ---------- Database ----------
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/**
 * =========================
 * PRODUCTS + CATEGORIES
 * =========================
 */
model Product {
  id              String  @id @default(cuid())
  fieldType       String
  name            String
  description     String?
  productImageUrl String?
  collection      String?
  sku             String? @unique
  ribbon          String?
  price           Float?
  surcharge       Float?
  visible         Boolean @default(true)
  discountMode    String?
  discountValue   Float?
  inventory       String?
  weight          Float?
  cost            Float?

  // --------- Analytics counters ----------
  views        Int @default(0)     // page impressions
  clicks       Int @default(0)     // CTA clicks (view/add-to-cart/quick-view)
  unitsSold    Int @default(0)     // total quantity sold
  revenuePence Int @default(0)     // accumulated revenue in pence

  productOptionName1        String?
  productOptionType1        String?
  productOptionDescription1 String?
  productOptionName2        String?
  productOptionType2        String?
  productOptionDescription2 String?
  productOptionName3        String?
  productOptionType3        String?
  productOptionDescription3 String?
  productOptionName4        String?
  productOptionType4        String?
  productOptionDescription4 String?
  productOptionName5        String?
  productOptionType5        String?
  productOptionDescription5 String?
  productOptionName6        String?
  productOptionType6        String?
  productOptionDescription6 String?

  additionalInfoTitle1       String?
  additionalInfoDescription1 String?
  additionalInfoTitle2       String?
  additionalInfoDescription2 String?
  additionalInfoTitle3       String?
  additionalInfoDescription3 String?
  additionalInfoTitle4       String?
  additionalInfoDescription4 String?
  additionalInfoTitle5       String?
  additionalInfoDescription5 String?
  additionalInfoTitle6       String?
  additionalInfoDescription6 String?

  customTextField1     String?
  customTextCharLimit1 Int?
  customTextMandatory1 Boolean?
  customTextField2     String?
  customTextCharLimit2 Int?
  customTextMandatory2 Boolean?

  brand     String?
  createdAt DateTime @default(now())

  // --------- Relations ----------
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dailyStats ProductDailyStat[]

  @@index([categoryId])
  @@index([views])
  @@index([clicks])
  @@index([unitsSold])
  @@index([revenuePence])
  @@index([sku])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToChildren")
  position  Int        @default(0)
  imageUrl  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]
}

/**
 * ---------- Daily analytics rollup ----------
 * One row per product per (UTC) day.
 */
model ProductDailyStat {
  id           String   @id @default(cuid())
  productId    String
  day          DateTime @db.Date
  views        Int      @default(0)
  clicks       Int      @default(0)
  unitsSold    Int      @default(0)
  revenuePence Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, day])
  @@index([day])
  @@index([views])
  @@index([clicks])
  @@index([unitsSold])
  @@index([revenuePence])
}

/**
 * =========================
 * USERS + AUTH + AUDIT
 * =========================
 */
model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String?
  name     String
  role     Role    @default(VIEWER)

  firstName    String?
  lastName     String?
  phoneE164    String?
  phoneRaw     String?
  phoneCountry String?

  source              UserSource @default(LOCAL)
  wixSubscriberStatus String?
  wixLanguage         String?
  wixCreatedAt        DateTime?
  wixLastActivity     String?
  wixLastActivityAt   DateTime?
  wixSource           String?
  wixImportedAt       DateTime?

  welcomeStatus WelcomeStatus @default(PENDING)
  welcomedAt    DateTime?

  emailVerified DateTime?

  // Stripe integration
  stripeCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restriction / Erasure
  deletedAt       DateTime?
  deletionReason  String?
  restrictedAt    DateTime?
  restrictionNote String?
  anonymizedAt    DateTime?
  isAnonymized    Boolean   @default(false)

  // OAuth / sessions
  accounts Account[]
  sessions Session[]

  // OTP / tokens
  passwordTokens PasswordToken[]

  // Audit
  audits UserAudit[]

  // Orders & Addresses
  orders    Order[]
  addresses Address[]

  @@index([email])
  @@index([deletedAt])
  @@index([isAnonymized])
}

enum Role {
  HEAD
  STAFF
  VIEWER
}

enum UserSource {
  LOCAL
  WIX
}

enum WelcomeStatus {
  PENDING
  SENT
  COMPLETED
}

enum UserAuditAction {
  CREATE
  UPDATE
  RESTRICT
  ANONYMIZE
  RESTORE
  HARD_DELETE
}

model UserAudit {
  id         String          @id @default(cuid())
  userId     String
  actorId    String?
  actorEmail String?
  action     UserAuditAction
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * ---------- Auth.js adapter ----------
 */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  kind      String
  title     String
  body      String
  meta      Json?
  link      String?
  readAt    DateTime?
  actorId   String?

  @@index([createdAt])
  @@index([readAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

/**
 * One-time password / welcome token
 */
model PasswordToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  code      String?
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * =========================
 * CONTENT (FAQ / Policies)
 * =========================
 */
model PolicyDoc {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @unique
  answer    String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, updatedAt])
}

model FaqSettings {
  id         Int      @id @default(1)
  heading    String   @default("FAQs")
  subheading String   @default("Get answers to common questions.")
  updatedAt  DateTime @updatedAt
}

model FaqQuestion {
  id         String   @id @default(cuid())
  question   String
  askedCount Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([askedCount, updatedAt])
}

/**
 * =========================
 * CHAT + SLA + PUSH
 * =========================
 */
model ChatThread {
  id        String        @id @default(cuid())
  userKey   String
  status    String        @default("open")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  lastUserAt            DateTime  @default(now())
  lastAdminAt           DateTime?
  escalatedAt           DateTime?
  emailEscalationSentAt DateTime?
  slaMinutes            Int       @default(10)
  customerEmail         String?
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       String
  content    String
  confidence Float?
  createdAt  DateTime   @default(now())

  @@index([threadId, createdAt])
}

model PushSubscription {
  id           String   @id @default(cuid())
  adminEmail   String?
  endpointJson String
  createdAt    DateTime @default(now())
}

/**
 * =========================
 * ORDERS + ADDRESSES
 * =========================
 */
enum OrderStatus {
  DRAFT
  PLACED
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  PARTIAL_REFUND
  REFUNDED
  FAILED
}

model Address {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  firstName String?
  lastName  String?
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String
  phoneE164 String?
  kind      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingFor Order[] @relation("ShippingAddress")
  billingFor  Order[] @relation("BillingAddress")
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  contactEmail String

  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)

  currency      String @default("GBP")
  subtotal      Int    @default(0)
  shippingTotal Int    @default(0)
  discountTotal Int    @default(0)
  taxTotal      Int    @default(0)
  grandTotal    Int    @default(0)

  shippingAddressId String?
  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)

  billingAddressId String?
  billingAddress   Address? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)

  paymentProvider String?
  paymentIntentId String?
  paymentRef      String?

  notes String?

  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentIntentId])
  @@index([contactEmail, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  sku       String?
  name      String
  imageUrl  String?

  unitPrice Int
  quantity  Int @default(1)
  lineTotal Int @default(0)

  options Json?

  createdAt DateTime @default(now())

  @@index([orderId])
}

/**
 * ---------- Stripe Payments ----------
 */
model Payment {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider       String   @default("stripe")
  intentId       String?  // Stripe PaymentIntent ID
  chargeId       String?  // Latest Stripe Charge ID
  refundId       String?  // Latest Refund ID

  amountPence    Int
  currency       String   @default("GBP")
  status         PaymentStatus
  idempotencyKey String?  @unique

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId])
  @@index([intentId])
  @@index([chargeId])
  @@index([refundId])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  source      String   @default("stripe")
  type        String
  eventId     String   @unique
  payload     Json
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  success     Boolean  @default(false)
  error       String?

  orderId     String?
  paymentId   String?

  @@index([type, receivedAt])
}

/**
 * =========================
 * HOME & ABOUT SETTINGS
 * =========================
 */
model HomeSettings {
  id              Int      @id @default(1)
  hero            Json     @default("{}")
  delivery        Json     @default("{}")
  instagram       Json     @default("{}")
  promotions      Json     @default("[]")
  productShowcase Json     @default("{}")
  reviews         Json     @default("{}")
  updatedAt       DateTime @updatedAt
}

model AboutSettings {
  id        Int      @id @default(1)
  hero      Json?    // { title, subtitle, imageUrl }
  media     Json?    // { imageUrl }
  story     Json?    // { heading, paragraphs[] }
  stats     Json?    // StatItem[]
  values    Json?    // ValueCard[]
  cta       Json?    // { text, href }
  updatedAt DateTime @updatedAt
}
