generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

/// *
///  * =========================
///  * SETTINGS
///  * =========================
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Media {
  id           String        @id @default(cuid())
  url          String
  kind         String?
  createdAt    DateTime      @default(now())
  name         String?
  updatedAt    DateTime      @updatedAt
  homeSections HomeSection[]

  @@index([createdAt])
  @@index([kind])
}

/// *
///  * =========================
///  * PRODUCTS + CATEGORIES
///  * =========================
model Product {
  id                          String             @id @default(cuid())
  fieldType                   String
  name                        String
  description                 String?
  productImageUrl             String?
  collection                  String?
  sku                         String?            @unique
  ribbon                      String?
  price                       Float?
  surcharge                   Float?
  visible                     Boolean            @default(true)
  discountMode                String?
  discountValue               Float?
  inventory                   String?
  weight                      Float?
  cost                        Float?
  productOptionName1          String?
  productOptionType1          String?
  productOptionDescription1   String?
  productOptionName2          String?
  productOptionType2          String?
  productOptionDescription2   String?
  productOptionName3          String?
  productOptionType3          String?
  productOptionDescription3   String?
  productOptionName4          String?
  productOptionType4          String?
  productOptionDescription4   String?
  productOptionName5          String?
  productOptionType5          String?
  productOptionDescription5   String?
  productOptionName6          String?
  productOptionType6          String?
  productOptionDescription6   String?
  additionalInfoTitle1        String?
  additionalInfoDescription1  String?
  additionalInfoTitle2        String?
  additionalInfoDescription2  String?
  additionalInfoTitle3        String?
  additionalInfoDescription3  String?
  additionalInfoTitle4        String?
  additionalInfoDescription4  String?
  additionalInfoTitle5        String?
  additionalInfoDescription5  String?
  additionalInfoTitle6        String?
  additionalInfoDescription6  String?
  customTextField1            String?
  customTextCharLimit1        Int?
  customTextMandatory1        Boolean?
  customTextField2            String?
  customTextCharLimit2        Int?
  customTextMandatory2        Boolean?
  brand                       String?
  createdAt                   DateTime           @default(now())
  categoryId                  String?
  clicks                      Int                @default(0)
  revenuePence                Int                @default(0)
  unitsSold                   Int                @default(0)
  views                       Int                @default(0)
  shippingWeightGrams         Int?
  additionalInfoDescription10 String?
  additionalInfoDescription7  String?
  additionalInfoDescription8  String?
  additionalInfoDescription9  String?
  additionalInfoTitle10       String?
  additionalInfoTitle7        String?
  additionalInfoTitle8        String?
  additionalInfoTitle9        String?
  productOptionDescription10  String?
  productOptionDescription11  String?
  productOptionDescription12  String?
  productOptionDescription13  String?
  productOptionDescription14  String?
  productOptionDescription15  String?
  productOptionDescription7   String?
  productOptionDescription8   String?
  productOptionDescription9   String?
  productOptionName10         String?
  productOptionName11         String?
  productOptionName12         String?
  productOptionName13         String?
  productOptionName14         String?
  productOptionName15         String?
  productOptionName7          String?
  productOptionName8          String?
  productOptionName9          String?
  productOptionType10         String?
  productOptionType11         String?
  productOptionType12         String?
  productOptionType13         String?
  productOptionType14         String?
  productOptionType15         String?
  productOptionType7          String?
  productOptionType8          String?
  productOptionType9          String?
  updatedAt                   DateTime           @default(now()) @updatedAt
  shippingTemp                ShippingTemp       @default(DRY)
  caseQty                     Int?
  tags                        String[]           @default([])
  category                    Category?          @relation(fields: [categoryId], references: [id])
  dailyStats                  ProductDailyStat[]
  PromotionProduct            PromotionProduct[]

  @@index([categoryId])
  @@index([views])
  @@index([clicks])
  @@index([unitsSold])
  @@index([revenuePence])
  @@index([shippingWeightGrams])
  @@index([shippingTemp])
  @@index([sku])
  @@index([tags], type: Gin)
}

model Category {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  parentId          String?
  position          Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  imageUrl          String?
  parent            Category?           @relation("CategoryToChildren", fields: [parentId], references: [id])
  children          Category[]          @relation("CategoryToChildren")
  products          Product[]
  PromotionCategory PromotionCategory[]
}

/// *
///  * ---------- Daily analytics rollup ----------
///  * One row per product per (UTC) day.
model ProductDailyStat {
  id           String   @id @default(cuid())
  productId    String
  day          DateTime @db.Date
  views        Int      @default(0)
  clicks       Int      @default(0)
  unitsSold    Int      @default(0)
  revenuePence Int      @default(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, day])
  @@index([day])
  @@index([views])
  @@index([clicks])
  @@index([unitsSold])
  @@index([revenuePence])
}

/// *
///  * =========================
///  * USERS + AUTH + AUDIT
///  * =========================
model User {
  id                            String                         @id @default(uuid())
  email                         String                         @unique
  password                      String?
  role                          Role                           @default(VIEWER)
  name                          String
  createdAt                     DateTime                       @default(now())
  firstName                     String?
  lastName                      String?
  phoneCountry                  String?
  phoneE164                     String?
  phoneRaw                      String?
  source                        UserSource                     @default(LOCAL)
  updatedAt                     DateTime                       @updatedAt
  welcomeStatus                 WelcomeStatus                  @default(PENDING)
  welcomedAt                    DateTime?
  wixCreatedAt                  DateTime?
  wixImportedAt                 DateTime?
  wixLanguage                   String?
  wixLastActivity               String?
  wixLastActivityAt             DateTime?
  wixSource                     String?
  wixSubscriberStatus           String?
  anonymizedAt                  DateTime?
  deletedAt                     DateTime?
  deletionReason                String?
  emailVerified                 DateTime?
  isAnonymized                  Boolean                        @default(false)
  restrictedAt                  DateTime?
  restrictionNote               String?
  stripeCustomerId              String?                        @unique
  accounts                      Account[]
  addresses                     Address[]
  addressBook                   AddressBook[]
  offerAttempts                 OfferAttempt[]
  orders                        Order[]
  orderOffers                   OrderOffer[]
  passwordTokens                PasswordToken[]
  promotionsLocked              Promotion[]                    @relation("PromotionLockedToUser")
  allowedPromotions             PromotionAllowedUser[]
  promotionRedemptions          PromotionRedemption[]
  sessions                      Session[]
  audits                        UserAudit[]
  customerDiscounts             CustomerDiscount[]
  createdCustomerDiscounts      CustomerDiscount[]             @relation("CustomerDiscountCreatedBy")
  orderCustomerDiscounts        OrderCustomerDiscount[]
  promotionEmailBlastsCreated   PromotionEmailBlast[]          @relation("PromotionEmailBlastCreatedBy")
  promotionEmailBlastRecipients PromotionEmailBlastRecipient[]
  OfferEmailBlastRecipient      OfferEmailBlastRecipient[]

  @@index([email])
  @@index([deletedAt])
  @@index([isAnonymized])
}

model UserAudit {
  id         String          @id @default(cuid())
  userId     String
  actorId    String?
  actorEmail String?
  action     UserAuditAction
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// *
///  * ---------- Auth.js adapter ----------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Notification {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  kind      String
  title     String
  body      String
  meta      Json?
  link      String?
  readAt    DateTime?
  actorId   String?

  @@index([createdAt])
  @@index([readAt])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

/// *
///  * One-time password / welcome token
model PasswordToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  code      String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// *
///  * =========================
///  * CONTENT (FAQ / Policies)
///  * =========================
model PolicyDoc {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @unique
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
  position  Int      @default(0)

  @@index([position, updatedAt])
}

model FaqSettings {
  id         Int      @id @default(1)
  heading    String   @default("FAQs")
  subheading String   @default("Get answers to common questions.")
  updatedAt  DateTime @updatedAt
}

model FaqQuestion {
  id         String   @id @default(cuid())
  question   String
  askedCount Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([askedCount, updatedAt])
}

/// *
///  * =========================
///  * CHAT + SLA + PUSH
///  * =========================
model ChatThread {
  id                    String        @id @default(cuid())
  userKey               String
  status                String        @default("open")
  createdAt             DateTime      @default(now())
  emailEscalationSentAt DateTime?
  escalatedAt           DateTime?
  lastAdminAt           DateTime?
  lastUserAt            DateTime      @default(now())
  slaMinutes            Int           @default(10)
  customerEmail         String?
  messages              ChatMessage[]
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  role       String
  content    String
  confidence Float?
  createdAt  DateTime   @default(now())
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model PushSubscription {
  id           String   @id @default(cuid())
  adminEmail   String?
  endpointJson String
  createdAt    DateTime @default(now())
}

model Address {
  id          String   @id @default(cuid())
  userId      String?
  firstName   String?
  lastName    String?
  line1       String
  line2       String?
  city        String
  postcode    String
  country     String
  phoneE164   String?
  kind        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  town        String?
  user        User?    @relation(fields: [userId], references: [id])
  billingFor  Order[]  @relation("BillingAddress")
  shippingFor Order[]  @relation("ShippingAddress")
}

/// *
///  * Saved, named addresses for a logged-in user (e.g. "Bob's house").
///  * Separate from Address snapshots used by Orders.
model AddressBook {
  id             String      @id @default(cuid())
  userId         String
  label          String
  isDefault      Boolean     @default(false)
  kind           AddressKind @default(SHIPPING)
  firstName      String?
  lastName       String?
  line1          String
  line2          String?
  town           String?
  city           String
  postcode       String
  country        String
  phoneE164      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  idempotencyKey String?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, isDefault])
}

model PromotionAttempt {
  id                    String              @id @default(cuid())
  checkoutId            String?
  code                  String?
  promotionId           String?
  userId                String?
  email                 String?
  orderId               String?
  outcome               PromoAttemptOutcome
  errorCode             String?
  currency              String              @default("GBP")
  subtotalPence         Int?
  shippingPence         Int?
  discountPence         Int                 @default(0)
  shippingDiscountPence Int                 @default(0)
  createdAt             DateTime            @default(now())
  usedAt                DateTime?
  order                 Order?              @relation(fields: [orderId], references: [id])
  promotion             Promotion?          @relation(fields: [promotionId], references: [id])

  @@index([code])
  @@index([promotionId])
  @@index([userId])
  @@index([email])
  @@index([orderId])
  @@index([createdAt])
  @@index([checkoutId, createdAt])
}

// =====================
// Offers: marketing + banner + email config
// =====================

model Offer {
  id                       String            @id @default(cuid())
  name                     String
  mode                     OfferMode         @default(AUTO)
  code                     String?           @unique
  status                   OfferStatus       @default(ACTIVE)
  startsAt                 DateTime?
  endsAt                   DateTime?
  stackingMode             OfferStackingMode @default(BEST_DISCOUNT_WINS)
  priority                 Int               @default(0)
  maxDiscountPerOrderPence Int?
  preventFreeOrder         Boolean           @default(false)
  visibility               OfferVisibility   @default(ALL)
  exclusions               Json?
  payload                  Json
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  // ✅ Banner fields
  bannerEnabled  Boolean   @default(false)
  bannerTitle    String?
  bannerMessage  String?
  bannerCtaLabel String?
  bannerCtaHref  String?
  bannerStartsAt DateTime?
  bannerEndsAt   DateTime?

  // ✅ Email fields
  emailEnabled Boolean @default(false)
  emailSubject String?
  emailMessage String?

  // ✅ blast runs
  emailBlasts OfferEmailBlast[]

  @@index([status, startsAt, endsAt])
  @@index([stackingMode, priority])
  @@index([createdAt])
  @@index([bannerEnabled, bannerStartsAt, bannerEndsAt])
  @@index([emailEnabled])
}

// =====================
// Offer email blasts (queue + recipients)
// =====================

model OfferEmailBlast {
  id          String   @id @default(cuid())
  offerId     String
  subject     String
  message     String?
  scope       OfferEmailScope @default(ALL_CUSTOMERS)

  // optional allow-list when scope=USERS
  userIds     Json?

  startedAt   DateTime?
  finishedAt  DateTime?
  sentCount   Int      @default(0)
  failedCount Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offer       Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  recipients  OfferEmailBlastRecipient[]

  @@index([offerId, createdAt])
  @@index([startedAt, finishedAt])
}

model OfferEmailBlastRecipient {
  id        String   @id @default(cuid())
  blastId   String
  userId    String?
  email     String
  status    OfferBlastRecipientStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  resendId  String?

  createdAt DateTime @default(now())

  blast     OfferEmailBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)
  user      User?           @relation(fields: [userId], references: [id])

  @@index([blastId, status])
  @@index([email, createdAt])
  @@index([userId, createdAt])
}

enum OfferEmailScope {
  ALL_CUSTOMERS
  SELECTED_USERS
}

enum OfferBlastRecipientStatus {
  PENDING
  SENT
  FAILED
}

enum BlastRecipientStatus {
  PENDING
  SENT
  FAILED
}

model OrderOffer {
  id            String   @id @default(cuid())
  orderId       String
  userId        String?
  emailUsed     String?
  offerId       String
  offerName     String
  offerKind     String?
  discountPence Int      @default(0)
  meta          Json?
  appliedAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([orderId, appliedAt])
  @@index([userId, appliedAt])
  @@index([emailUsed, appliedAt])
  @@index([offerId, appliedAt])
}

model Order {
  id                       String                  @id @default(cuid())
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  userId                   String?
  contactEmail             String
  status                   OrderStatus             @default(DRAFT)
  paymentStatus            PaymentStatus           @default(PENDING)
  currency                 String                  @default("GBP")
  subtotal                 Int                     @default(0)
  shippingTotal            Int                     @default(0)
  discountTotal            Int                     @default(0)
  taxTotal                 Int                     @default(0)
  grandTotal               Int                     @default(0)
  shippingAddressId        String?
  billingAddressId         String?
  paymentProvider          String?
  paymentIntentId          String?
  paymentRef               String?
  notes                    String?
  displayId                String                  @unique
  totalWeightGrams         Int?
  archivedAt               DateTime?
  canceledAt               DateTime?
  canceledReason           String?
  editableUntil            DateTime?
  notesAdmin               String?
  refundTotal              Int                     @default(0)
  cancelReversalReason     String?
  cancelReversedAt         DateTime?
  cancelReversibleUntil    DateTime?
  cancellationRequestedAt  DateTime?
  refundAmountPence        Int?
  refundExecutedAt         DateTime?
  refundId                 String?
  refundQueuedAt           DateTime?
  promotionCode            String?
  promotionId              String?
  shippingRateId           String?
  shippingService          ShippingService?
  shippingTemp             ShippingTemp?
  shippingZoneId           String?
  offerAttempts            OfferAttempt[]
  billingAddress           Address?                @relation("BillingAddress", fields: [billingAddressId], references: [id])
  promotion                Promotion?              @relation(fields: [promotionId], references: [id])
  shippingAddress          Address?                @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  user                     User?                   @relation(fields: [userId], references: [id])
  activities               OrderActivity[]
  items                    OrderItem[]
  orderOffers              OrderOffer[]
  orderPromotions          OrderPromotion[]
  orderTags                OrderTag[]
  payments                 Payment[]
  promoAttempts            PromotionAttempt[]
  promotionRedemptions     PromotionRedemption[]
  returnCase               ReturnCase?
  shipments                Shipment[]
  customerDiscountsApplied OrderCustomerDiscount[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentIntentId])
  @@index([contactEmail, createdAt])
  @@index([cancellationRequestedAt])
  @@index([cancelReversibleUntil])
  @@index([refundQueuedAt])
  @@index([refundExecutedAt])
  @@index([promotionId, createdAt])
  @@index([promotionCode])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  sku             String?
  name            String
  imageUrl        String?
  unitPrice       Int
  quantity        Int      @default(1)
  lineTotal       Int      @default(0)
  options         Json?
  createdAt       DateTime @default(now())
  unitWeightGrams Int?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderActivity {
  id        String       @id @default(cuid())
  orderId   String
  type      ActivityType
  note      String?
  meta      Json?
  createdAt DateTime     @default(now())
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OfferAttempt {
  id                    String              @id @default(cuid())
  checkoutId            String?
  offerId               String
  offerName             String?
  offerKind             String?
  userId                String?
  email                 String?
  orderId               String?
  outcome               OfferAttemptOutcome
  errorCode             String?
  currency              String              @default("GBP")
  subtotalPence         Int?
  shippingPence         Int?
  discountPence         Int                 @default(0)
  shippingDiscountPence Int                 @default(0)
  usedAt                DateTime?
  createdAt             DateTime            @default(now())
  order                 Order?              @relation(fields: [orderId], references: [id])
  user                  User?               @relation(fields: [userId], references: [id])

  @@index([offerId])
  @@index([offerName])
  @@index([userId])
  @@index([email])
  @@index([orderId])
  @@index([createdAt])
  @@index([checkoutId, createdAt])
}

model Tag {
  id        String     @id @default(cuid())
  slug      String     @unique
  label     String
  color     String?
  createdAt DateTime   @default(now())
  orders    OrderTag[]
}

model OrderTag {
  orderId    String
  tagId      String
  assignedAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([orderId, tagId])
}

model Promotion {
  id                       String                 @id @default(cuid())
  name                     String
  code                     String?                @unique
  type                     PromotionType          @default(CODE)
  status                   PromotionStatus        @default(ACTIVE)
  startsAt                 DateTime?
  endsAt                   DateTime?
  lockedToUserId           String?
  lockedToEmail            String?
  maxUsesTotal             Int?
  maxUsesPerUser           Int?
  discountType             PromotionDiscountType
  percentOff               Int?
  amountOffPence           Int?
  applyShippingDiscount    Boolean                @default(false)
  shippingPercentOffDry    Int?
  shippingPercentOffFrozen Int?
  targetType               PromotionTargetType    @default(SITE_WIDE)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  applyMode                PromotionApplyMode     @default(CODE)
  priority                 Int                    @default(0)
  stackPolicy              PromotionStackPolicy   @default(BEST_DISCOUNT_WINS)
  campaignKey              CampaignKey?           @default(CUSTOM)
  eligibleCustomerScope    PromotionCustomerScope @default(ALL)
  orders                   Order[]
  orderPromotions          OrderPromotion[]
  lockedToUser             User?                  @relation("PromotionLockedToUser", fields: [lockedToUserId], references: [id])
  allowedUsers             PromotionAllowedUser[]
  promoAttempts            PromotionAttempt[]
  categories               PromotionCategory[]
  products                 PromotionProduct[]
  redemptions              PromotionRedemption[]
  emailBlasts              PromotionEmailBlast[]

  @@index([status, startsAt, endsAt])
  @@index([lockedToUserId])
  @@index([lockedToEmail])
  @@index([applyMode, status])
  @@index([priority])
  @@index([campaignKey])
  @@index([eligibleCustomerScope])
}

model PromotionCategory {
  promotionId String
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

model PromotionProduct {
  promotionId String
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionAllowedUser {
  promotionId String
  userId      String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([promotionId, userId])
  @@index([userId])
}

model PromotionRedemption {
  id                    String    @id @default(cuid())
  promotionId           String
  orderId               String
  userId                String?
  emailUsed             String?
  discountPence         Int       @default(0)
  shippingDiscountPence Int       @default(0)
  createdAt             DateTime  @default(now())
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion             Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user                  User?     @relation(fields: [userId], references: [id])

  @@unique([orderId, promotionId])
  @@index([promotionId, createdAt])
  @@index([userId, createdAt])
  @@index([emailUsed, createdAt])
}

enum PromoEmailBlastScope {
  ALL_CUSTOMERS
  SELECTED_USERS
}

enum PromoEmailRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model PromotionEmailBlast {
  id          String    @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("PromotionEmailBlastCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  scope      PromoEmailBlastScope @default(ALL_CUSTOMERS)
  subject    String
  message    String?
  createdAt  DateTime             @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  plannedCount Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)

  recipients PromotionEmailBlastRecipient[]

  @@index([promotionId, createdAt])
  @@index([createdAt])
}

model PromotionEmailBlastRecipient {
  id      String              @id @default(cuid())
  blastId String
  blast   PromotionEmailBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email    String
  status   PromoEmailRecipientStatus @default(PENDING)
  resendId String?
  error    String?
  sentAt   DateTime?

  @@unique([blastId, email])
  @@index([email])
  @@index([status])
}

model CustomerDiscount {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ✅ who created it (admin/staff)
  createdByAdminId String?
  createdByAdmin   User?   @relation("CustomerDiscountCreatedBy", fields: [createdByAdminId], references: [id])

  percentOff               Int // 1–100 (enforce in app)
  applyShippingDiscount    Boolean @default(false)
  shippingPercentOffDry    Int?
  shippingPercentOffFrozen Int?

  startsAt DateTime?
  endsAt   DateTime?

  // ✅ revoke without deleting history
  revokedAt    DateTime?
  revokeReason String?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersApplied OrderCustomerDiscount[]

  @@index([userId, createdAt])
  @@index([userId, startsAt, endsAt])
  @@index([revokedAt])
}

model OrderCustomerDiscount {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerDiscountId String?
  customerDiscount   CustomerDiscount? @relation(fields: [customerDiscountId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // snapshots (immutable)
  percentOff               Int
  applyShippingDiscount    Boolean
  shippingPercentOffDry    Int?
  shippingPercentOffFrozen Int?

  // computed results (optional but useful)
  discountPence         Int @default(0)
  shippingDiscountPence Int @default(0)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([customerDiscountId])
}

model OrderPromotion {
  id                    String    @id @default(cuid())
  orderId               String
  promotionId           String
  codeUsed              String?
  discountPence         Int       @default(0)
  shippingDiscountPence Int       @default(0)
  appliedAt             DateTime  @default(now())
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion             Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([orderId, promotionId])
  @@index([promotionId, appliedAt])
  @@index([orderId, appliedAt])
}

model ShippingZone {
  id        String             @id @default(cuid())
  name      String
  isActive  Boolean            @default(true)
  priority  Int                @default(0)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  rates     ShippingRate[]
  rules     ShippingZoneRule[]

  @@index([isActive, priority])
}

model ShippingZoneRule {
  id             String       @id @default(cuid())
  zoneId         String
  countryCode    String
  postcodeRegex  String?
  postcodePrefix String?
  createdAt      DateTime     @default(now())
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([countryCode])
  @@index([zoneId])
}

model ShippingRate {
  id            String             @id @default(cuid())
  zoneId        String
  temp          ShippingTemp
  service       ShippingService    @default(STANDARD)
  currency      String             @default("GBP")
  freeOverPence Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  zone          ShippingZone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  tiers         ShippingRateTier[]

  @@unique([zoneId, temp, service])
  @@index([temp, service])
}

model ShippingRateTier {
  id                String       @id @default(cuid())
  rateId            String
  minGramsExclusive Int          @default(0)
  maxGramsInclusive Int?
  pricePence        Int
  rate              ShippingRate @relation(fields: [rateId], references: [id], onDelete: Cascade)

  @@index([rateId, minGramsExclusive])
}

/// *
///  * ---------- Stripe Payments ----------
model Payment {
  id             String        @id @default(cuid())
  orderId        String
  provider       String        @default("stripe")
  intentId       String?
  chargeId       String?
  refundId       String?
  amountPence    Int
  currency       String        @default("GBP")
  status         PaymentStatus
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([intentId])
  @@index([chargeId])
  @@index([refundId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  source      String    @default("stripe")
  type        String
  eventId     String    @unique
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  success     Boolean   @default(false)
  error       String?
  orderId     String?
  paymentId   String?

  @@index([type, receivedAt])
}

model HomeSection {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  type      HomeSectionType @default(PRODUCT_CAROUSEL)
  enabled   Boolean         @default(false)
  position  Int             @default(0)
  startAt   DateTime?
  endAt     DateTime?
  isLocked  Boolean         @default(false)
  config    Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  mediaId   String?
  media     Media?          @relation(fields: [mediaId], references: [id])

  @@index([enabled, position])
  @@index([startAt, endAt])
  @@index([mediaId])
}

/// *
///  * =========================
///  * HOME & ABOUT SETTINGS
///  * =========================
model HomeSettings {
  id                  Int      @id @default(1)
  hero                Json     @default("{}")
  delivery            Json     @default("{}")
  instagram           Json     @default("{}")
  promotions          Json     @default("[]")
  promotionBanner     Json     @default("{}")
  celebrationSections Json     @default("[]")
  productShowcase     Json     @default("{}")
  reviews             Json     @default("{}")
  updatedAt           DateTime @updatedAt
  sections            Json     @default("{}")
}

model AboutSettings {
  id        Int      @id @default(1)
  hero      Json?
  media     Json?
  story     Json?
  stats     Json?
  values    Json?
  cta       Json?
  updatedAt DateTime @updatedAt
}

model ReturnCase {
  id             String            @id @default(cuid())
  orderId        String            @unique
  status         ReturnCaseStatus  @default(OPEN)
  receivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  meta           Json?
  shipmentId     String?
  detectedAt     DateTime          @default(now())
  lastEventAt    DateTime?
  resolvedAt     DateTime?
  issueType      DeliveryIssueType @default(UNKNOWN)
  resolution     ReturnResolution?
  resolutionNote String?
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment       Shipment?         @relation(fields: [shipmentId], references: [id])

  @@index([status, detectedAt])
  @@index([issueType, detectedAt])
  @@index([shipmentId])
}

/// *
///  * =========================
///  * SHIPPING / FULFILLMENT
///  * =========================
///  * Merged model: keeps your original fields + APC specifics.
///  * Supports multiple shipments per order (remove @unique on orderId).
model Shipment {
  id                  String       @id @default(cuid())
  orderId             String
  carrier             String       @default("APC")
  service             String?
  trackingNumber      String?
  trackingUrl         String?
  labelUrl            String?
  weightGrams         Int?
  costPence           Int?
  status              String       @default("PENDING")
  shippedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  costTotal           Decimal?     @db.Decimal(10, 2)
  currency            String?      @default("GBP")
  labelBase64         String?
  labelMime           String?
  serviceCode         String?
  trackingEvents      Json?
  waybill             String?
  trackingEmailSentAt DateTime?
  idempotencyKey      String?      @unique
  reshipOfShipmentId  String?
  dispatchedAt        DateTime?
  labelReadyAt        DateTime?
  voidedAt            DateTime?
  returnCases         ReturnCase[]
  order               Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reshipOfShipment    Shipment?    @relation("ShipmentReshipChain", fields: [reshipOfShipmentId], references: [id])
  reships             Shipment[]   @relation("ShipmentReshipChain")

  @@index([orderId])
  @@index([carrier, serviceCode])
  @@index([waybill])
  @@index([trackingNumber])
  @@index([reshipOfShipmentId])
}

